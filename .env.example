# Copy to `.env` (or `.env.local`) and uncomment to flip the auth flows
# from the local mocks to a real backend.
#
# When VITE_API_BASE is set, src/services/auth.js POSTs to:
#   ${VITE_API_BASE}/auth/login
#   ${VITE_API_BASE}/auth/2fa
#   ${VITE_API_BASE}/auth/register
#   ${VITE_API_BASE}/auth/verify?token=…
#   ${VITE_API_BASE}/auth/forgot
#   ${VITE_API_BASE}/auth/otp
#   ${VITE_API_BASE}/auth/reset
#   ${VITE_API_BASE}/auth/logout
#
# Server must respond with JSON shaped as:
#   200 OK  → { data: { … } }
#   4xx/5xx → { error: 'message', fieldErrors: { fieldName: 'message' } }
#
# VITE_API_BASE=https://api.svitch.bike

# ────────────────────────────────────────────────────────────────────────
# Google Maps JavaScript API key — used by the Charging Network page
# (src/features/support/charging-network/ChargingMap.jsx) to render the
# real map, geolocate the user, and draw driving directions to a station.
#
# Enable these APIs on the key:
#   • Maps JavaScript API
#   • Directions API
#   • Places API
# Restrict the key to your production domain(s) before publishing.
#
# VITE_GOOGLE_MAPS_API_KEY=YOUR_KEY_HERE
